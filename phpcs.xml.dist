<?xml version="1.0"?>
<ruleset name="NaluzPHP">
    <description>PSR-12 (which includes PSR-1) for the framework, the starter app and the tests.</description>
    <file>app</file>
    <file>tests</file>
    <file>config</file>
    <file>routes</file>
    <file>database</file>
    <file>bootstrap</file>
    <file>public</file>
    <file>naluz</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>
    <rule ref="PSR12"/>
    <!-- Test fixtures may declare several small classes next to the test that uses them. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!-- Views are templates, not PHP class files. -->
    <exclude-pattern>resources/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
