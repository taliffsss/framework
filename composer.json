{
    "name": "naluz/naluzphp",
    "description": "NaluzPHP application skeleton — clone, composer install, and start building. The framework itself is the naluz/framework package.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "orm",
        "query-builder",
        "rest-api",
        "psr",
        "queue",
        "mailer",
        "scheduler",
        "templating"
    ],
    "authors": [
        {
            "name": "Mark Anthony Naluz",
            "email": "anthony.naluz15@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "naluz/framework": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Naluz\\Tests\\": "tests/"
        }
    },
    "bin": [
        "naluz"
    ],
    "scripts": {
        "test": "phpunit",
        "serve": "@php naluz run:server",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php naluz key:generate"
        ],
        "cs": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "cs-fix": "phpcbf",
        "check": [
            "@cs",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-redis": "Not required: NaluzPHP ships its own Redis client.",
        "ext-pcntl": "Lets queue:work shut down gracefully on SIGTERM/SIGINT.",
        "mongodb/mongodb": "MongoDB driver for NoSQL (needs ext-mongodb); the file and memory NoSQL drivers need nothing.",
        "ext-pdo_sqlsrv": "Microsoft SQL Server (with the Microsoft ODBC driver)."
    },
    "extra": {
        "naluz": {
            "dont-discover": []
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/framework",
            "options": {
                "symlink": true
            }
        }
    ]
}
