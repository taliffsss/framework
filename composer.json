{
    "name": "naluz/naluzphp",
    "description": "NaluzPHP \u2014 a modern, secure PHP framework for monolithic apps and REST APIs, with a built-in ORM and query builder.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "orm",
        "query-builder",
        "rest-api",
        "psr",
        "queue",
        "mailer",
        "scheduler",
        "templating"
    ],
    "authors": [
        {
            "name": "Mark Anthony Naluz",
            "email": "anthony.naluz15@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/link": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Naluz\\": "src/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Naluz\\Tests\\": "tests/"
        }
    },
    "bin": [
        "naluz"
    ],
    "scripts": {
        "test": "phpunit",
        "serve": "@php naluz run:server",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php naluz key:generate"
        ],
        "cs": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "cs-fix": "phpcbf",
        "check": [
            "@cs",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-redis": "Not required: NaluzPHP ships its own Redis client.",
        "ext-pcntl": "Lets queue:work shut down gracefully on SIGTERM/SIGINT.",
        "mongodb/mongodb": "MongoDB driver for NoSQL (needs ext-mongodb); the file and memory NoSQL drivers need nothing.",
        "ext-pdo_sqlsrv": "Microsoft SQL Server (with the Microsoft ODBC driver)."
    },
    "extra": {
        "naluz": {
            "dont-discover": []
        }
    }
}
