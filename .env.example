APP_NAME=NaluzPHP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=UTC

# Logging: LOG_CHANNEL = daily | single | stderr | errorlog | slack | production (daily + slack) | null
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAYS=14
LOG_SLACK_WEBHOOK_URL=

# sqlite | mysql | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Secret for API tokens (HS256) — at least 32 characters. Generate one with `php naluz key:generate --show`.
JWT_SECRET=

SESSION_SECURE=

# Redis (cache: CACHE_DRIVER=redis, sessions: SESSION_DRIVER=redis, queue: QUEUE_CONNECTION=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail: MAIL_MAILER=log (default, writes to storage/logs) | smtp | array
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
