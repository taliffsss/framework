APP_NAME=NaluzPHP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=UTC

# sqlite | mysql | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Secret for API tokens (HS256) — at least 32 characters. Generate one with `php naluz key:generate --show`.
JWT_SECRET=

SESSION_SECURE=
